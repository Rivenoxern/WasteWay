# WasteWay Backend Environment Configuration
# Copy this file to .env and fill in your values.

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/wasteway_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_key
